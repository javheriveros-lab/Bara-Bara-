{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npx pnpm@9.15.0 install --frozen-lockfile && npx pnpm@9.15.0 --filter backend build"
  },
  "deploy": {
    "startCommand": "node backend/dist/main",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
