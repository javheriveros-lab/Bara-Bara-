# Backend
# MongoDB Atlas (gratis, M0): Database > Connect > Drivers. Incluye el nombre de la BD (/bara_bara).
DATABASE_URL="mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/bara_bara?retryWrites=true&w=majority"
# Local con Docker (docker compose up -d):
# DATABASE_URL="mongodb://localhost:27017/bara_bara?replicaSet=rs0&directConnection=true"
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Genera uno propio: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d
# Proxies de confianza para X-Forwarded-For (rate limit por IP real). En producción: la IP/subred del servidor web.
TRUST_PROXY=loopback

# ImageKit (fotos y documentos). Panel de ImageKit > Developer options. Sin estas variables se
# puede publicar, pero sin fotos. La llave privada es secreta: solo aquí, nunca en el frontend.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/TU_ID
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# ImageKit también guarda como archivos privados la INE, el comprobante de domicilio y los
# comprobantes de pago. Solo los admins los ven, con enlaces que caducan en 10 minutos.

# Comisiones (5% en venta, renta y chamba; trueque gratis). Cuenta donde los vecinos pagan por SPEI.
# Sin CLABE y beneficiario, el botón "Pagar por SPEI" responde que el pago aún no está configurado.
PAYMENT_CLABE=
PAYMENT_BENEFICIARY=
PAYMENT_BANK_NAME=
# Conciliación automática: el banco/proveedor firma el webhook POST /api/payments/webhook con este
# secreto (HMAC-SHA256 del cuerpo en X-BaraBara-Signature). Genera uno largo y aleatorio.
PAYMENT_WEBHOOK_SECRET=

# Correo (recuperar contraseña). Resend: resend.com > API Keys. Sin clave, los correos solo se
# escriben en el log del backend (útil en desarrollo). MAIL_FROM debe usar un dominio verificado en Resend.
RESEND_API_KEY=
MAIL_FROM="Bara Bara <hola@tu-dominio.mx>"
# URL pública del sitio: el backend la usa para armar el enlace de "restablecer contraseña".
# (La web también la lee, más abajo, con el mismo nombre.)

# Monitoreo de errores (opcional). sentry.io > proyecto > Client Keys (DSN).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Web (servidor de Next → API; solo servidor, no se expone al navegador)
API_URL=http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL pública del sitio (Open Graph, sitemap y enlaces de los correos)
SITE_URL=http://localhost:3000

# Datos legales que aparecen en /privacidad, /terminos y /contacto. Sin ellos se ve un aviso de borrador.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:4000
